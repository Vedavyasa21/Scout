# Scout configuration. Copy to `.env` and fill in values.
# NEVER commit your real `.env` file.

# --- AI provider ---
# Provider adapter to use. Currently supported: "gemini"
SCOUT_PROVIDER=gemini

# API key for the selected provider. Required at runtime.
SCOUT_API_KEY=

# Model name. Must support function calling and (for voice) audio input.
# flash-lite responds in ~1s; larger Flash models take 9s or more per turn.
SCOUT_MODEL=gemini-3.5-flash-lite
# Optional thinking budget. -1 uses the provider default; 0 disables thinking
# on models that support it (not supported by every flash-lite model).
SCOUT_THINKING_BUDGET=-1
# Thinking level for Gemini 3 models: minimal/low/medium/high, or empty.
# "minimal" keeps replies around 1.6s per turn; the provider falls back
# automatically if the selected model rejects it.
SCOUT_THINKING_LEVEL=minimal

# --- Agent behaviour ---
# Hard cap on model <-> tool round trips per request.
SCOUT_MAX_TOOL_STEPS=8
# Timeout in seconds for a single tool execution.
SCOUT_TOOL_TIMEOUT=60
# Timeout in seconds for a provider request.
SCOUT_REQUEST_TIMEOUT=120
# Retries for transient provider failures (429/5xx/timeouts).
SCOUT_MAX_RETRIES=2

# --- Safety ---
# Comma-separated directories Scout may read from. Defaults to the user home
# directory when empty. Paths are resolved and must exist.
SCOUT_WORKSPACES=

# Comma-separated allowlisted applications, as executable names or absolute
# paths. Defaults to a small, safe set (notepad, calculator, explorer, ...).
SCOUT_ALLOWED_APPS=

# --- Voice and overlay ---
# Optional transcription model; empty uses SCOUT_MODEL.
SCOUT_VOICE_MODEL=
# Maximum length of one spoken request, in seconds.
SCOUT_VOICE_MAX_SECONDS=15
# Stop recording after this much silence following speech.
SCOUT_VOICE_SILENCE_SECONDS=1.2
# Floating icon opacity (0.3 - 1.0). Medium opacity is intentional.
SCOUT_OVERLAY_OPACITY=0.65
# Custom label shown on the floating overlay (e.g. 'scout').
SCOUT_OVERLAY_LABEL=scout

# --- Logging ---
SCOUT_LOG_LEVEL=INFO
# Optional explicit log file path. Defaults to the user data directory.
SCOUT_LOG_FILE=
